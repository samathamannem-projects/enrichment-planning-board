# Copy to .env.local for local cloud testing, and set the same two variables in Vercel
# (Project → Settings → Environment Variables). Find these in Supabase:
# Project Settings → API → "Project URL" and "Project API keys → anon public".
# Leave them unset to run the app with local storage and no login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
